generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  OWNER
  ADMIN
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
  FROZEN
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  passwordHash String
  name         String
  role         UserRole @default(USER)
  createdAt    DateTime @default(now())

  restaurants  Restaurant[]
  favorites    Favorite[]
  reservations ReservationRequest[]
}

// 7 oblasts + Бишкек + Ош (города республиканского значения)
model Region {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  districts   District[]
  restaurants Restaurant[]
}

// 40 районов, привязанных к своей области
model District {
  id       String @id @default(cuid())
  name     String
  slug     String
  regionId String
  region   Region @relation(fields: [regionId], references: [id])

  restaurants Restaurant[]

  @@unique([regionId, name])
}

// Отдельный плоский список городов Кыргызстана
model City {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  restaurants Restaurant[]
}

model Restaurant {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  nameSubtitle String?
  description  String
  address      String

  landmark          String?
  landmarkDistanceM Int?
  landmarkWalkMin   Int?

  cityId     String?
  city       City?     @relation(fields: [cityId], references: [id])
  regionId   String?
  region     Region?   @relation(fields: [regionId], references: [id])
  districtId String?
  district   District? @relation(fields: [districtId], references: [id])

  type     String
  avgCheck Int?
  capacity Int? // вместимость банкетного зала, гостей

  hasVeranda       Boolean @default(false)
  hasOpenKitchen   Boolean @default(false)
  hasOnlineBooking Boolean @default(false)
  hasDiscounts     Boolean @default(false)

  contactName  String? // контактное лицо
  contactPhone String?
  whatsapp     String?
  website      String?

  coverImage String?
  photos     RestaurantPhoto[]
  priceIcons String? // JSON-encoded array of {icon,label,price}

  status RestaurantStatus @default(PENDING)

  // подписка партнёра: ресторан виден на сайте, только пока оплачен
  subscriptionPaidUntil DateTime?

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  favorites    Favorite[]
  reservations ReservationRequest[]
  payments     Payment[]

  @@index([status])
  @@index([cityId])
  @@index([regionId])
  @@index([districtId])
}

model Payment {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  amount       Int // сом
  periodStart  DateTime
  periodEnd    DateTime
  createdAt    DateTime   @default(now())

  @@index([restaurantId])
}

model RestaurantPhoto {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  url          String
  sortOrder    Int        @default(0)
}

model Favorite {
  id           String     @id @default(cuid())
  userId       String
  restaurantId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([userId, restaurantId])
}

model ReservationRequest {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?      @relation(fields: [userId], references: [id])

  guestName   String
  guestPhone  String
  partySize   Int
  preferredAt DateTime
  comment     String?
  status      String   @default("NEW") // NEW | CONTACTED | CLOSED
  createdAt   DateTime @default(now())
}
